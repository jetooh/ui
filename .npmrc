# devDependencies are required for typecheck/build/test. Some CI and agent
# environments export NODE_ENV=production, from which npm *derives* omit=dev and
# silently skips them (tsc/vitest then "not found"). `include` is the documented
# inverse of `omit` and wins regardless of order, so installs in this repo are
# always complete, whatever the ambient NODE_ENV.
include=dev
